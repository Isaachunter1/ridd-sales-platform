# server/.env — local development only. NEVER commit a real .env.
# In production every "secret" row lives in Secret Manager and is attached
# to the Cloud Run service (server/README.md, step 4). config/env.js is the
# only file that reads these; add a variable there first, then here.

# ── Core ─────────────────────────────────────────────────────────────────
PORT=8080
NODE_ENV=development
SITE_URL=                        # the app's public URL — links in Slack lines (optional)
CORS_ORIGINS=*                   # POC: any origin. Later: https://<app>.netlify.app,https://*--<app>.netlify.app

# ── Supabase ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=               # public key — used only to verify user JWTs
SUPABASE_SERVICE_ROLE_KEY=       # secret — bypasses RLS; server only

# ── Jobs ─────────────────────────────────────────────────────────────────
API_TOKEN=                       # secret — any long random string; Cloud Scheduler sends it as X-API-TOKEN
DRY_RUN=false                    # true = jobs compute but write nothing; published files land in server/dryrun/
JOB_VERSION=dev                  # Cloud Build sets the commit SHA

# ── BigQuery (RevHawk mirror) — same service account the Netlify sync used ─
GCP_SA_JSON=                     # secret — the whole key-file JSON on one line (preferred) …
GCP_SA_EMAIL=                    # … or the split pair
GCP_SA_PRIVATE_KEY=
REVHAWK_PROJECT_ID=revhawkdataconnect
REVHAWK_DATASET=org_ridd_pest_control_3f4149
GCP_JOB_PROJECT=                 # your own project, where queries run + bill (defaults to REVHAWK_PROJECT_ID)

# ── Slack ────────────────────────────────────────────────────────────────
SLACK_ADMIN_WEBHOOK=             # secret — incoming webhook for a private admin channel; unset = logs only
